@model IEnumerable<TaskFlowWeb.Models.TaskItem>

@{
    ViewData["Title"] = "Tareas";
}

<h1>Tareas</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear Nueva Tarea</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Título</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Prioridad</th>
            <th>Fecha límite</th>
            <th>Proyecto</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>@task.Status</td>
                <td>@task.Priority</td>
                <td>@(task.DueDate.ToString("yyyy-MM-dd"))</td>
                <td>@task.Project?.Name</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@task.Id">Detalles</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@task.Id">Editar</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@task.Id">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>